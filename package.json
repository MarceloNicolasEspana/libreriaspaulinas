        "concurrently": "^10.0.3",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.12.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0",
        "vue": "^3.5.42",
        "vue-eslint-parser": "^10.4.1"
    },
